// Zellij Configuration

// Theme
theme "catppuccin-mocha"

// General settings
// simplified_ui true
// pane_frames false
default_shell "zsh"
mouse_mode true
// copy_on_select false
// scrollback_editor "nvim"

// Behavior
on_force_close "quit"
scroll_buffer_size 10000

// UI settings
default_layout "compact"
default_mode "normal"

// Session settings
session_serialization false
pane_viewport_serialization false
scrollback_lines_to_serialize 0

keybinds clear-defaults=true {
    // Normal mode - primary interaction mode
    normal {
        // Unbind Ctrl+b (tmux default), we'll use Ctrl+a style prefix-less bindings
        // Zellij doesn't have prefix keys, so we use direct bindings

        // Pane navigation (Alt+h/j/k/l - mirrors tmux M-h/j/k/l)
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt Left" { MoveFocus "Left"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Right" { MoveFocus "Right"; }

        // Pane resizing (Ctrl+h/j/k/l - mirrors tmux C-h/j/k/l)
        bind "Ctrl h" { Resize "Increase Left"; }
        bind "Ctrl j" { Resize "Increase Down"; }
        bind "Ctrl k" { Resize "Increase Up"; }
        bind "Ctrl l" { Resize "Increase Right"; }
        bind "Ctrl Left" { Resize "Increase Left"; }
        bind "Ctrl Down" { Resize "Increase Down"; }
        bind "Ctrl Up" { Resize "Increase Up"; }
        bind "Ctrl Right" { Resize "Increase Right"; }

        // Pane creation/splitting (Ctrl+Alt+h/j/k/l - mirrors tmux C-M-h/j/k/l)
        bind "Ctrl Alt h" { NewPane "Left"; }
        bind "Ctrl Alt j" { NewPane "Down"; }
        bind "Ctrl Alt k" { NewPane "Up"; }
        bind "Ctrl Alt l" { NewPane "Right"; }
        bind "Ctrl Alt Left" { NewPane "Left"; }
        bind "Ctrl Alt Down" { NewPane "Down"; }
        bind "Ctrl Alt Up" { NewPane "Up"; }
        bind "Ctrl Alt Right" { NewPane "Right"; }

        // Pane actions
        bind "Ctrl Alt x" { CloseFocus; } // Mirror tmux C-M-x
        bind "Enter" { ToggleFocusFullscreen; } // Mirror tmux prefix+enter zoom

        // Tab (session-like) navigation
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt n" { NewTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }

        // Session management (mirrors tmux prefix+s, prefix+a)
        bind "Ctrl a" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }

        // Tmux sessionizer equivalent (mirrors tmux prefix+f)
        bind "Ctrl f" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zjstatus.wasm" {
                floating true
                move_to_focused_tab true
            }
        }

        // Alt g - floating lazygit
        bind "Alt g" {
            NewPane {
                floating true
                command "lazygit"
                close_on_exit true
            }
        }
        // Alt Shift g - lazygit in new pane
        bind "Alt G" {
            NewPane "Down" {
                command "lazygit"
                close_on_exit true
            }
        }

        // Alt i - floating lazydocker
        bind "Alt i" {
            NewPane {
                floating true
                command "lazydocker"
                close_on_exit true
            }
        }
        // Alt Shift i - lazydocker in new pane
        bind "Alt I" {
            NewPane "Down" {
                command "lazydocker"
                close_on_exit true
            }
        }

        // Mode switching
        bind "Ctrl s" { SwitchToMode "Scroll"; }
        bind "Ctrl o" { SwitchToMode "Session"; }
        bind "Ctrl t" { SwitchToMode "Tab"; }
        bind "Ctrl p" { SwitchToMode "Pane"; }
        bind "Ctrl r" { SwitchToMode "Resize"; }
        bind "Ctrl m" { SwitchToMode "Move"; }

        // Search
        bind "Ctrl Slash" { SwitchToMode "Search"; }

        // Quit
        bind "Ctrl q" { Quit; }

        // Detach
        bind "Ctrl d" { Detach; }
    }

    // Scroll mode
    scroll {
        bind "Ctrl s" "Esc" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Alt h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Alt l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Alt j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Alt k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
    }

    // Search mode
    search {
        bind "Ctrl Slash" "Esc" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    // Pane mode
    pane {
        bind "Ctrl p" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left" { NewPane "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { NewPane "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }

    // Tab mode (Zellij's equivalent to tmux sessions)
    tab {
        bind "Ctrl t" "Esc" { SwitchToMode "Normal"; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "h" "Left" { GoToPreviousTab; }
        bind "j" "Down" { GoToNextTab; }
        bind "k" "Up" { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
    }

    // Resize mode
    resize {
        bind "Ctrl r" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // Move mode
    move {
        bind "Ctrl m" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" { MovePane; }
        bind "Tab" { MovePaneBackwards; }
    }

    // Session mode
    session {
        bind "Ctrl o" "Esc" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }

    // Rename pane mode
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // Rename tab mode
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // Shared bindings across all modes
    shared_except "locked" {
        bind "Alt q" { Quit; }
    }
}

// Plugins configuration
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
}

// UI components
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}
